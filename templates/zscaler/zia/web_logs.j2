{%- set user = registry.get_random_user() -%}
{%- set device = registry.get_random_device() -%}
{%- set current_time = current_timestamp() -%}
{%- set formatted_time = format_timestamp(current_time, '%a %b %d %H:%M:%S %Y') -%}
{%- set severities = ['Low', 'Medium', 'High', 'Critical'] -%}
{%- set severity = severities | random -%}
{%- set risk_scores = {'Low': random_int(1, 45), 'Medium': random_int(46, 74), 'High': random_int(75, 89), 'Critical': random_int(90, 100)} -%}
{%- set risk_score = risk_scores[severity] -%}
{%- set request_data_size = random_int(50, 200) -%}
{%- set response_size = random_int(5000, 15000) -%}
{%- set req_methods = ['GET', 'POST', 'PUT', 'DELETE', 'HEAD'] -%}
{%- set req_method = req_methods | random -%}
{%- set resp_codes = ['200', '302', '403', '404', '503'] -%}
{%- set resp_code = '403' if severity != 'Low' else (resp_codes | random) -%}
